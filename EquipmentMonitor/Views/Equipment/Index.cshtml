@model IEnumerable<EquipmentMonitor.Models.Equipment>

@{
    ViewData["Title"] = "Моніторинг обладнання";
}

<div class="container mt-4">
    <h2 class="mb-4 text-center">Платформа моніторингу стану обладнання</h2>

    <!-- Статистичні картки -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-secondary mb-3 text-center">
                <div class="card-body">
                    <h5 class="card-title">Всього пристроїв</h5>
                    <h3>@ViewBag.TotalCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3 text-center">
                <div class="card-body">
                    <h5 class="card-title">Працює</h5>
                    <h3>@ViewBag.WorkingCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3 text-center">
                <div class="card-body">
                    <h5 class="card-title">Обслуговується</h5>
                    <h3>@ViewBag.MaintenanceCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger mb-3 text-center">
                <div class="card-body">
                    <h5 class="card-title">Несправне</h5>
                    <h3>@ViewBag.BrokenCount</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Пошук та кнопка додавання -->
    <form asp-action="Index" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <input type="text" name="searchString" class="form-control" placeholder="Пошук за назвою або інв. номером..." />
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select" asp-items="Html.GetEnumSelectList<EquipmentStatus>()">
                <option value="">-- Всі статуси --</option>
            </select>
        </div>
        <div class="col-md-3 d-flex justify-content-between">
            <button type="submit" class="btn btn-primary w-50 me-2">Шукати</button>
            <a asp-action="Create" class="btn btn-success w-50">+ Додати</a>
        </div>
    </form>

    <!-- Таблиця обладнання -->
    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Назва</th>
                <th>Інвентарний №</th>
                <th>Розташування</th>
                <th>Дата придбання</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.Name</strong></td>
                    <td>@item.InventoryNumber</td>
                    <td>@item.Location</td>
                    <td>@item.PurchaseDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (item.Status == EquipmentStatus.Working)
                        {
                            <span class="badge bg-success">Працює</span>
                        }
                        else if (item.Status == EquipmentStatus.UnderMaintenance)
                        {
                            <span class="badge bg-warning text-dark">На обслуговуванні</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Несправне</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>